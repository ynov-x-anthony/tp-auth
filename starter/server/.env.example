# En dev, le serveur démarre SANS .env : des valeurs de repli sont définies dans src/config.ts.
# Pour surcharger, exportez ces variables dans votre shell avant `npm run dev`, p. ex. :
#   JWT_SECRET="..." PORT=3001 npm run dev
# (ou ajoutez le paquet `dotenv` - hors périmètre du TP).

# Secret utilisé pour signer les JWT. EN PRODUCTION : longue chaîne aléatoire, jamais commitée.
JWT_SECRET=dev-secret-not-for-production

# Port de l'API
PORT=3001

# Origine autorisée par CORS (l'URL du front Vite)
CLIENT_ORIGIN=http://localhost:5173
